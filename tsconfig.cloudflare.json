{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "paths": {
      "solid-objects/core": ["./src/core.ts"],
      "solid-objects/cloudflare": ["./src/cloudflare/index.ts"]
